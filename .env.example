# ── LLM (OpenAI) ────────────────────────────────────────────────────────────
# Every agent calls the OpenAI API through google-adk's LiteLlm wrapper
# (see common/llm_config.py). Any OpenAI chat model id works here, e.g.
# gpt-4o-mini (cheap, default) or gpt-4o (higher quality, pricier).
LLM_MODEL=gpt-4o-mini

# Get this from https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key

# ── Tools ───────────────────────────────────────────────────────────────────
SERPAPI_API_KEY=your-serpapi-key

# ── Agent Ports ─────────────────────────────────────────────────────────────
HOST_AGENT_PORT=8000
FLIGHT_AGENT_PORT=8001
RESEARCH_AGENT_PORT=8002
ACCOMMODATION_FOOD_AGENT_PORT=8003
ITINERARY_AGENT_PORT=8004

# ── Agent URLs (used by the Host Agent to reach the others) ─────────────────
FLIGHT_AGENT_URL=http://localhost:8001
RESEARCH_AGENT_URL=http://localhost:8002
ACCOMMODATION_FOOD_AGENT_URL=http://localhost:8003
ITINERARY_AGENT_URL=http://localhost:8004

# ── App ─────────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000
NODE_ENV=development
